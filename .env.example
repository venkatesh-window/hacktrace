# ==========================================
# RAZORPAY TEST PAYMENT INTEGRATION
# ==========================================
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ==========================================
# OFFICER NOTIFICATION SYSTEM (EMAIL & SMS)
# ==========================================
# Minimum risk confidence (0.0 to 1.0) required to trigger officer alerts (Default: 0.70 = 70%)
ALERT_CONFIDENCE_THRESHOLD=0.70

# --- EMAIL ALERT CONFIGURATION (SMTP) ---
# For Gmail: Use smtp.gmail.com with an App Password (generated at myaccount.google.com/apppasswords)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
ALERT_SENDER_EMAIL=your_email@gmail.com
ALERT_SENDER_PASSWORD=your_app_password_here
# Comma-separated recipient emails (officers / nodal team)
OFFICER_EMAILS=officer1@police.gov.in,nodal.sbi@bank.com

# --- SMS ALERT CONFIGURATION ---
# Target recipient mobile numbers (comma-separated, 10 digits or with country code)
OFFICER_PHONES=9876543210


# Twilio Provider (Optional / Global: https://www.twilio.com)
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890
